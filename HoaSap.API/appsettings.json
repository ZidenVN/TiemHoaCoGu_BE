{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "Initialize": false,
    "Seed": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hoasap.db;Default Timeout=30"
  },
  "Jwt": {
    "Issuer": "HoaSap.API",
    "Audience": "HoaSap.Client",
    "ExpirationMinutes": 60
  },
  "Auth": {
    "PasswordResetMinutes": 30,
    "PasswordResetUrlBase": "https://localhost/shop/"
  },
  "Notifications": {
    "EmailEnabled": false,
    "SmsEnabled": false,
    "MaxAttempts": 8,
    "LeaseSeconds": 120,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "From": ""
    },
    "Sms": {
      "Mode": "Disabled",
      "TestAccountSid": "",
      "TestAuthToken": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "Quản trị viên",
    "PhoneNumber": ""
  },
  "Media": {
    "StoragePath": "App_Data/media",
    "MaximumBytes": 921600
  },
  "DataProtection": {
    "KeyPath": ""
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "AuthPermitLimit": 15,
    "WindowSeconds": 60,
    "AuthWindowSeconds": 60,
    "MaxBuckets": 100000,
    "TrustForwardedHeaders": false,
    "TrustedProxies": []
  },
  "Payments": {
    "Gateway": {
      "Provider": "MomoSandbox",
      "Endpoint": "",
      "MerchantId": "",
      "Secret": "",
      "MomoPartnerCode": "",
      "MomoAccessKey": "",
      "MomoSecretKey": "",
      "MomoIpnUrl": "",
      "TimeoutSeconds": 30,
      "AllowedReturnOrigins": []
    }
  },
  "Shipping": {
    "Carrier": {
      "Provider": "Disabled",
      "Endpoint": "",
      "MerchantId": "",
      "Secret": "",
      "Origin": "",
      "TimeoutSeconds": 15,
      "QuoteLifetimeMinutes": 15
    },
    "GhnStaging": {
      "Token": "",
      "ShopId": 0
    }
  }
}
